# Copia este archivo a .streamlit/secrets.toml para desarrollo local con
# Streamlit, o pega este mismo contenido en el gestor de "Secrets" de
# Streamlit Community Cloud al desplegar (Settings -> Secrets).
#
# .streamlit/secrets.toml NUNCA debe subirse a git (ver .gitignore).

ALPACA_API_KEY = "your_alpaca_paper_api_key_here"
ALPACA_SECRET_KEY = "your_alpaca_paper_secret_key_here"
ANTHROPIC_API_KEY = "your_anthropic_api_key_here"
NEWSAPI_KEY = "your_newsapi_key_here"

# Contraseña compartida para poder usar el dashboard público (ver
# dashboard/app.py::require_password). Sin esta clave, cualquier
# visitante podría gastar tu cuota de Claude/NewsAPI o tocar tu cuenta
# paper. Elegí una contraseña propia, no dejes este placeholder.
APP_PASSWORD = "elige-una-contrasena-fuerte-aca"
